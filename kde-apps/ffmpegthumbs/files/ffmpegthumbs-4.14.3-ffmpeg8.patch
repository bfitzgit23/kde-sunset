+AVFrame* MovieDecoder::createAVFrame(int width, int height, AVPixelFormat format)
+{
+    AVFrame* frame = av_frame_alloc();
+
+    if (frame == NULL) {
+        kDebug() << "Failed to allocate a frame";
+        return NULL;
+    }
+
+    frame->format = format;
+    frame->width  = width;
+    frame->height = height;
+
+    if (av_frame_get_buffer(frame, 32) < 0) {
+        kDebug() << "Failed to allocate a frame buffer";
+        av_frame_free(&frame);
+        return NULL;
+    }
+
+    return frame;
+}
