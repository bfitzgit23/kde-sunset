--- a/kalarm/CMakeLists.txt
+++ b/kalarm/CMakeLists.txt
@@ -269,4 +269,8 @@
 target_link_libraries(kalarm_helper ${KDE4_KDECORE_LIBS})
 install(TARGETS kalarm_helper DESTINATION ${LIBEXEC_INSTALL_DIR})
 kde4_install_auth_helper_files(kalarm_helper org.kde.kalarmrtcwake root)
-kde4_install_auth_actions(org.kde.kalarmrtcwake rtcwakeaction.actions)
+# CMake 4 (CMP0037) rejects the target name kde4_install_auth_actions() builds
+# from a reverse-DNS helper id ("actions for org.kde.kalarmrtcwake"), and the policy it
+# generates depends on the KAuth backend kdelibs was built with (the fake
+# backend emits nothing).  Install the pre-generated policy shipped in
+# FILESDIR from src_install() instead of calling the macro.
