TagLib 2 renamed MP4::ItemListMap to MP4::ItemMap and itemListMap() to itemMap(),
and its item map no longer has a non-const operator[] path through the file, so
the lookup goes through Tag::item(). Guard both forms on the version.
--- a/coverinfo.cpp
+++ b/coverinfo.cpp
@@ -299,8 +299,12 @@
     {
         TagLib::MP4::Tag *tag = mp4File->tag();
         if (tag) {
+#if TAGLIB_MAJOR_VERSION >= 2
+            return tag->itemMap().contains("covr");
+#else
             TagLib::MP4::ItemListMap &items = tag->itemListMap();
             return items.contains("covr");
+#endif
         }
     }
 #endif
@@ -363,12 +367,20 @@
