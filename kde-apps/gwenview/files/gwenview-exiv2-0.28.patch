+
+#ifndef GWENVIEW_EXIV2COMPAT_H
+#define GWENVIEW_EXIV2COMPAT_H
+
+// Exiv2
+#include <exiv2/image.hpp>
+#include <exiv2/version.hpp>
+
+#include <utility>
+
+// Exiv2 0.28 replaced the std::auto_ptr based AutoPtr typedefs with
+// std::unique_ptr based UniquePtr ones.
+#if EXIV2_TEST_VERSION(0, 28, 0)
+typedef Exiv2::Image::UniquePtr GwenviewExiv2ImagePtr;
+#  define GWENVIEW_EXIV2_MOVE(x) std::move(x)
+#else
+typedef Exiv2::Image::AutoPtr GwenviewExiv2ImagePtr;
+#  define GWENVIEW_EXIV2_MOVE(x) (x)
+#endif
+
+#endif /* GWENVIEW_EXIV2COMPAT_H */
