+/*
+ * Plasma::WebView without QtWebKit.
+ *
+ * widgets/webview.h is installed unconditionally and is used by consumers
+ * (kde-runtime's QML bindings and JavaScript script engine, kdeplasma-addons
+ * and others).  When QtWebKit is unavailable, webview.cpp is not compiled, and
+ * with -Wl,--no-undefined every consumer then fails to link with undefined
+ * references to Plasma::WebView.  This file keeps the class linkable: the
+ * widget exists, renders as an empty frame and loads nothing.
+ */
+
+#include <QtCore/QPointF>
+#include <QtCore/QSizeF>
+#include <QtCore/QUrl>
+#include <QtCore/QVariant>
+#include <QtGui/QFocusEvent>
